# ==========================================
# Envoy
# ==========================================

ENVOY_HTTP_PORT=8080
ENVOY_ADMIN_PORT=9901

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-postgres-password
POSTGRES_ADMIN_DB=postgres

ORDER_DB_NAME=order_service_db
ORDER_DB_USER=order_service_user
ORDER_DB_PASSWORD=local-order-password

PAYMENT_DB_NAME=payment_service_db
PAYMENT_DB_USER=payment_service_user
PAYMENT_DB_PASSWORD=local-payment-password

# ==========================================
# MongoDB
# ==========================================

MONGODB_DATABASE=restaurant_menu_db

# ==========================================
# RabbitMQ
# ==========================================

RABBITMQ_USER=platform
RABBITMQ_PASSWORD=local-rabbitmq-password
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# Google Cloud Identity Platform
# ==========================================

GOOGLE_CLOUD_PROJECT_ID=replace-me

# ==========================================
# Base Sepolia
# ==========================================

BASE_SEPOLIA_RPC_URL=
ESCROW_CONTRACT_ADDRESS=